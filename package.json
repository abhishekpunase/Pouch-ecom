{
  "name": "paunch-ecom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:clean && concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:clean": "node scripts/clean-dev-ports.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@supabase/server": "^1.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.38.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.10",
    "razorpay": "^2.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
